# =====================================================================
# Lexxus Backend — environment variables
# Copy to .env and fill in values. Never commit .env.
# =====================================================================

# --- Server -----------------------------------------------------------
NODE_ENV=development
PORT=5000
APP_NAME=Lexxus
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:5000
LOG_LEVEL=info
COOKIE_DOMAIN=                    # leave empty for localhost; ".lexxus.com" in prod

# --- Auth -------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-32-bytes-minimum-please-rotate
JWT_REFRESH_SECRET=change-me-32-bytes-minimum-please-rotate-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_COST=12

# --- Database ---------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/lexxus
# If mongodb+srv:// fails with querySrv ECONNREFUSED (SRV DNS blocked), set public resolvers:
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
# Or use Atlas → Connect → Drivers: “standard connection string” (mongodb://… not mongodb+srv://).

# --- Redis (optional in dev; required in prod) ------------------------
REDIS_URL=                        # e.g. redis://localhost:6379 or rediss://upstash...

# --- Backblaze B2 -----------------------------------------------------
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=lexxus-files
B2_REGION=us-east-005
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_ENDPOINT_HOST=s3.us-east-005.backblazeb2.com
CDN_DOMAIN=files.lexxus.com

# --- Cloudflare (optional, for cache purges) --------------------------
CF_ACCOUNT_ID=
CF_API_TOKEN=

# --- Zoho Payments ----------------------------------------------------
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_WEBHOOK_SECRET=
ZOHO_API_BASE=https://payments.zoho.in/api/v1

# --- SMTP (Zoho Mail) -------------------------------------------------
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@lexxus.com
SMTP_PASS=
MAIL_FROM="Lexxus <no-reply@lexxus.com>"

# --- Misc -------------------------------------------------------------
DOWNLOAD_TOKEN_TTL_DAYS=30
DOWNLOAD_LIMIT_PER_ORDER=5
DOWNLOAD_RATE_LIMIT_PER_HOUR=10
GLOBAL_RATE_LIMIT_PER_15MIN=300
SENTRY_DSN=
